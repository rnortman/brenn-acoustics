"""Holds the Cargo manifest to the Bazel build.

`cargo_check_test` runs the pinned toolchain's cargo, `cargo check --offline
--all-targets`, over a copy of `Cargo.toml` and the sources the Bazel build
lists, so a manifest Cargo rejects, or a crate that builds under Bazel and not
under Cargo, fails the default check. It needs no linker and no network, and runs no host cargo.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "cargo_check_test",
    size = "small",
    srcs = ["cargo_check_test.sh"],
    data = [
        "//:cargo_sources",
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rust_stdlib_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
    ],
    env = {
        "CARGO": "$(rootpath @rules_rust//rust/toolchain:current_cargo_files)",
        "CARGO_SOURCES": "$(rootpaths //:cargo_sources)",
        "RUSTC": "$(rootpath @rules_rust//rust/toolchain:current_rustc_files)",
        "RUST_STD": "$(rootpaths @rules_rust//rust/toolchain:current_rust_stdlib_files)",
    },
)
